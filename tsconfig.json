{
  "compilerOptions": {
    "target": "ESNext", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "noUncheckedIndexedAccess": true, "types": ["bun"],
    "esModuleInterop": true, "skipLibCheck": true, "noEmit": true,
    "resolveJsonModule": true
  },
  "include": ["src", "tests"]
}
