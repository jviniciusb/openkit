// Example opencode-kit configuration (JSONC — comments are allowed).
//
// Place this at:
//   ~/.config/opencode/opencode-kit.jsonc            (global)
//   <project>/.opencode/opencode-kit.jsonc           (project)
//
// `configVersion` is the current schema version. See the JSON Schema for the
// full shape: https://raw.githubusercontent.com/jviniciusb/opencode-kit/main/opencode-kit.schema.json
{
  "$schema": "https://raw.githubusercontent.com/jviniciusb/opencode-kit/main/opencode-kit.schema.json",
  "configVersion": 1,
  "tools": {
    "background-subagents": {
      // Opt-in: forces every `subagent` call to run in the background so the
      // parent keeps control while a child works.
      "enabled": false,
      "settings": {}
    },
    "context-injections": {
      // Opt-in: injects built-in behavioral rules before every model request.
      // Built-in rule ids: think-in-code, functional-programming, decomposition,
      // subagent-driven, careful-changes. All default to on; disable the ones you
      // don't want and add your own strings to `extra`.
      "enabled": false,
      "settings": {
        "rules": { "subagent-driven": false },
        "extra": ["Any additional instruction you want injected."]
      }
    }
    // Add further tools as `"<tool-id>": { "enabled": true, "settings": { ... } }`.
    // A disabled tool's `register` never runs, so none of its tools, commands,
    // skills, or hooks exist. `enable`/`disable` and `config set` write here.
  },
  "skills": {
    // Skills are declarative instruction packages (`src/skills/<id>/SKILL.md`).
    // Unlike tools they take no `settings` — only `enabled`. Both bundled
    // skills default to on.
    "english-writing-assistant": {
      // Model-visible: advertised to the model so it can use the skill on its own.
      "enabled": true
    },
    "sdd-flow": {
      // Registered with `autoinvoke: false`, so it stays off the model's
      // advertised list; invoke it explicitly with `@sdd-flow`.
      "enabled": true
    }
    // Add further skills as `"<skill-id>": { "enabled": true }`.
    // `enable`/`disable` and the `/kit` command write here.
  },
  "references": {
    // References are declarative content sources (`src/references/<id>/reference.json`)
    // exposed to the session through `ctx.reference`. They are opt-in and
    // settings-bearing; `settings` override the source's `path`/`repository`/`branch`.
    // The category ships empty today — add one with `opencode-kit new reference <id>`.
    //
    // "project-docs": {
    //   "enabled": true,
    //   "settings": { "path": "./docs/v2" }
    // }
  }
}
