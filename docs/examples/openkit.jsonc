// Example openkit configuration (JSONC — comments are allowed).
//
// Place this at:
//   ~/.config/opencode/openkit.jsonc            (global)
//   <project>/.opencode/openkit.jsonc           (project)
//
// `configVersion` is the current schema version. See the JSON Schema for the
// full shape: https://raw.githubusercontent.com/jviniciusb/openkit/main/openkit.schema.json
{
  "$schema": "https://raw.githubusercontent.com/jviniciusb/openkit/main/openkit.schema.json",
  "configVersion": 1,
  "tools": {
    "background-subagents": {
      // On by default: forces every `subagent` call to run in the background so
      // the parent keeps control while a child works.
      "enabled": true,
      "settings": {}
    },
    "context-injections": {
      // On by default: injects built-in behavioral rules before every model
      // request. Built-in rule ids: proactive, think-in-code, functional-programming,
      // decomposition, subagent-driven, careful-changes. All default to on;
      // disable the ones you don't want and add your own strings to `extra`.
      "enabled": true,
      "settings": {
        "rules": { "subagent-driven": false },
        "extra": ["Any additional instruction you want injected."]
      }
    }
    // Add further tools as `"<tool-id>": { "enabled": true, "settings": { ... } }`.
    // A disabled tool's `register` never runs, so none of its tools, commands,
    // skills, or hooks exist. `enable`/`disable` and `config set` write here.
  },
  "skills": {
    // Skills are declarative instruction packages (`src/skills/<id>/SKILL.md`).
    // Unlike tools they take no `settings` — only `enabled`. All bundled
    // skills default to on. A disabled skill is not registered at all;
    // `autoinvoke` is packaged with the skill (frontmatter or barrel), not
    // config, and only controls whether the model sees it advertised.
    "english-writing-assistant": {
      // Model-visible: advertised to the model so it can use the skill on its own.
      "enabled": true
    },
    "sdd-flow": {
      // Registered with `autoinvoke: false`, so it stays off the model's
      // advertised list; invoke it explicitly with `@sdd-flow`.
      "enabled": true
    },
    "interview": {
      // Model-visible: aligns on design or requirements before implementation.
      "enabled": true
    },
    "skill-recipe": {
      // Registered with `autoinvoke: false`; the authoring aid, invoked with
      // `@skill-recipe` to derive a new kit skill from a brief and sources.
      "enabled": true
    },
    "research": {
      // Model-visible: settles a factual question with cited findings from
      // primary sources, delegating the reading to a background subagent.
      "enabled": true
    },
    "handoff": {
      // Registered with `autoinvoke: false`; invoke it explicitly with
      // `@handoff` to compact the conversation into a resumable document.
      "enabled": true
    },
    "code-review": {
      // Model-visible: reviews a change along Standards and Spec, and verifies
      // feedback against the code before acting on it.
      "enabled": true
    },
    "diagnosing-bugs": {
      // Model-visible: root-causes a bug from evidence before changing
      // production code.
      "enabled": true
    },
    "verification": {
      // Model-visible: proves a completion claim against the current tree
      // before reporting success.
      "enabled": true
    },
    "prototype": {
      // Model-visible: builds throwaway code to resolve one design uncertainty
      // before committing to an approach.
      "enabled": true
    },
    "retro": {
      // Registered with `autoinvoke: false`; invoke it explicitly with `@retro`
      // to turn a finished session's friction into proposed environment changes.
      "enabled": true
    },
    "finishing-a-branch": {
      // Registered with `autoinvoke: false`; invoke it explicitly with
      // `@finishing-a-branch` to land completed work safely or leave it in place.
      "enabled": true
    },
    "dispatching-parallel-agents": {
      // Model-visible: delegates one agent per independent task and runs them
      // concurrently, keeping the coordinator's context for integration.
      "enabled": true
    },
    "using-git-worktrees": {
      // Model-visible: sets up or verifies an isolated workspace before feature
      // work, preferring the harness's native worktree tool.
      "enabled": true
    },
    "writing-for-agents": {
      // Model-visible: writes agent-facing documents so the agent lands on the
      // intended behavior on every run.
      "enabled": true
    },
    "codebase-design": {
      // Model-visible: designs deep modules behind a small interface at a clean
      // seam, for leverage, locality, and testability.
      "enabled": true
    },
    "improve-codebase-architecture": {
      // Registered with `autoinvoke: false`; invoke it explicitly with
      // `@improve-codebase-architecture` to survey a codebase read-only for
      // deepening opportunities.
      "enabled": true
    },
    "to-spec": {
      // Registered with `autoinvoke: false`; invoke it explicitly with
      // `@to-spec` to distill the current conversation into a written spec.
      "enabled": true
    },
    "wizard": {
      // Model-visible: builds a guided interactive script for steps only a human
      // can take — credentials, approvals, external consoles.
      "enabled": true
    },
    "router": {
      // Registered with `autoinvoke: false`; invoke it explicitly with `@router`
      // to name the one kit skill or flow that fits a request.
      "enabled": true
    },
    "diagnosing-sessions": {
      // Registered with `autoinvoke: false`; invoke it explicitly with
      // `@diagnosing-sessions` to forensically explain why a past session went
      // wrong.
      "enabled": true
    }
    // Add further skills as `"<skill-id>": { "enabled": true }`.
    // `enable`/`disable` and the `/kit` command write here.
  }
}
